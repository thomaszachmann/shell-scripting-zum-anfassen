#!/usr/bin/env bash
# notes-backup-check – gibt es ein frisches Backup? notes-backup-check [-d ziel] stunden
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/lib.sh"
ziel="$HOME/sh-lab/backups"
if [[ ${1:-} == -d ]]; then
  ziel="${2:?-d braucht einen Ordner}"
  shift 2
fi
if (($# != 1)) || [[ ! $1 =~ ^[0-9]+$ ]]; then
  die "Aufruf: $PROG [-d ziel] stunden" 2
fi
[[ -d $ziel ]] || die "kein Ordner: $ziel"
neu=$(find "$ziel" -maxdepth 1 -name 'notes-*.sql.gz' -mmin "-$(($1 * 60))" \
  -printf '%f\n' | sort -r | head -1)
[[ -n $neu ]] || die "kein Backup jünger als $1 h in $ziel"
echo "ok: $neu"
