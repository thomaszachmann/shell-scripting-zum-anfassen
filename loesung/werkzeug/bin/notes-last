#!/usr/bin/env bash
# notes-last – erzeugt Verkehr für notes: notes-last [anzahl]
set -euo pipefail
url="${NOTES_URL:-http://127.0.0.1:8080}"
anzahl="${1:-50}"
if [[ ! $anzahl =~ ^[0-9]+$ ]]; then
  echo "Anzahl muss eine Zahl sein: $anzahl" >&2
  exit 2
fi
for ((i = 1; i <= anzahl; i++)); do
  case $((i % 10)) in
    0) notes-add "Lastnotiz $i" >/dev/null ;;
    1 | 2 | 3 | 4) curl -s -o /dev/null -A notes-last "$url/notes" ;;
    5 | 6) curl -s -o /dev/null -A notes-last "$url/healthz" ;;
    7) curl -s -o /dev/null -A notes-last "$url/version" ;;
    8) curl -s -o /dev/null -A notes-last "$url/notes/$i" ;;
    9) curl -s -o /dev/null -A notes-last "$url/admin" ;;
    *) ;;
  esac
done
echo "$anzahl Anfragen an $url"
